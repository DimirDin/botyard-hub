# Блок для /etc/caddy/Caddyfile на сервере платформы (см. §1 MASTER_CONTEXT).
# Path-роутинг: API/health на backend (порт 3016), всё остальное — статика фронтенда.

hub.botyard.site {
    handle /api/* {
        reverse_proxy 127.0.0.1:3016
    }
    handle /health {
        reverse_proxy 127.0.0.1:3016
    }
    handle {
        root * /srv/apps/botyard-hub/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
